generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum PaymentMethod {
  PHONE_PAY
  CASH
}

enum PaymentState {
  SUCCESS
  FAILED
  PENDING
}

enum ClassStatus {
  OPEN
  CLOSED
  CANCELED
}

model User {
  id               String         @id @default(uuid())
  name             String
  profileImageDataUrl String?
  age              Int?
  fitnessGoals     String?
  personalRecords  Json?
  email            String         @unique
  phone            String?
  checkInQrCode    String         @unique @default(uuid())
  role             Role           @default(MEMBER)
  passwordHash     String?
  supabaseUserId   String?        @unique
  membershipStart  DateTime?
  nextPaymentDue   DateTime?
  paymentStatus    PaymentStatus  @default(UNPAID)
  paymentMethod    PaymentMethod?
  inviteSentAt     DateTime?
  inviteAcceptedAt DateTime?
  lastLoginAt      DateTime?
  webAccessApproved Boolean        @default(false)
  webAccessApprovedAt DateTime?
  webAccessApprovedById String?
  webAccessApprovedBy User?        @relation("WebAccessApprover", fields: [webAccessApprovedById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payments         Payment[]
  classSignups     ClassSignup[]
  coachingAssignments Class[]      @relation("ClassCoach")
  secondaryCoachingAssignments Class[] @relation("ClassSecondaryCoach")
  workoutLogs      WorkoutLog[]
  coachedSessions  CoachClassSession[]
  approvedUsers    User[]         @relation("WebAccessApprover")
  deviceTokens     DeviceToken[]

  @@index([role])
  @@index([nextPaymentDue])
  @@index([supabaseUserId])
}

model Payment {
  id                     String        @id @default(uuid())
  user                   User          @relation(fields: [userId], references: [id])
  userId                 String
  amount                 Int
  planCode               String?
  planName               String?
  quantity               Int           @default(1)
  method                 PaymentMethod
  status                 PaymentState  @default(PENDING)
  date                   DateTime      @default(now())
  stripePaymentIntentId  String?
  createdAt              DateTime      @default(now())

  @@index([userId])
}

model Workout {
  id          String    @id @default(uuid())
  date        DateTime  @unique
  description String
  createdAt   DateTime  @default(now())
  workoutLogs WorkoutLog[]

  @@index([date])
}

model Class {
  id        String       @id @default(uuid())
  title     String
  datetime  DateTime
  capacity  Int
  coach     User?        @relation("ClassCoach", fields: [coachId], references: [id])
  coachId   String?
  secondaryCoach User?   @relation("ClassSecondaryCoach", fields: [secondaryCoachId], references: [id])
  secondaryCoachId String?
  status    ClassStatus  @default(OPEN)
  createdAt DateTime     @default(now())

  signups   ClassSignup[]
  workoutLogs WorkoutLog[]
  coachedSessions CoachClassSession[]

  @@index([datetime])
  @@index([coachId])
  @@index([secondaryCoachId])
}

model ClassSignup {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  createdAt DateTime @default(now())
  checkedInAt DateTime?

  @@unique([userId, classId])
  @@index([classId])
  @@index([checkedInAt])
}

model WorkoutLog {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  class          Class     @relation(fields: [classId], references: [id])
  classId        String
  workout        Workout?  @relation(fields: [workoutId], references: [id])
  workoutId      String?
  checkedInAt    DateTime
  weight         String?
  completionTime String?
  movementScales String?
  coachNotes     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, classId])
  @@index([userId, checkedInAt])
  @@index([checkedInAt])
  @@index([classId])
  @@index([workoutId])
}

model CoachClassSession {
  id        String   @id @default(uuid())
  coach     User     @relation(fields: [coachId], references: [id])
  coachId   String
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  createdAt DateTime @default(now())

  @@unique([coachId, classId])
  @@index([coachId])
  @@index([classId])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  platform  String
  badgeCount Int     @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}
